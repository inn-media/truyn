{
  "schema": "truyn.production-metrics-collector/v1",
  "collectorId": "prod-relay-metrics-collector-01",
  "deploymentId": "dc4518de-d1bf-4fce-b351-e43d7c152999",
  "collectorClass": "opentelemetry-collector-contrib-sidecar",
  "collectorVersion": "0.158.0",
  "relayRole": "relay",
  "metricsListener": {
    "host": "127.0.0.1",
    "port": 9464,
    "path": "/metrics",
    "loopbackOnly": true,
    "publicIngress": false
  },
  "backend": {
    "backendId": "prod-prometheus-01",
    "transport": "prometheus-remote-write",
    "privateEnvironmentOnly": true
  },
  "requiredMetrics": [
    "truyn_http_requests_total",
    "truyn_dispatch_attempts_total",
    "truyn_result_delivery_total",
    "truyn_runtime_ready"
  ],
  "status": "deployment_pending_live_series_proof",
  "liveMetricsObserved": false,
  "acceptedSourceSha": null,
  "publicResourceIdentity": false,
  "evidenceContract": {
    "required": [
      "relay metrics listener bound to 127.0.0.1:9464",
      "node-local collector scrapes relay /metrics",
      "collector remote-writes to the private production metrics backend",
      "backend PromQL exposes all four required metric families",
      "truyn_runtime_ready for role=relay is observed with value 1",
      "sanitized exact-main evidence status PASS"
    ],
    "forbiddenPublicFields": [
      "Container App names",
      "Container Apps environment names or FQDNs",
      "ACR names or login servers",
      "Azure resource identifiers",
      "tenant/subscription identifiers",
      "credentials"
    ]
  },
  "invariant": "The relay /metrics listener must remain loopback-only. liveMetricsObserved may become true only after the private backend independently exposes all required metric families from the node-local collector."
}
