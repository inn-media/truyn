{
  "schema": "truyn.production-trace-backend/v2",
  "backendId": "prod-traces-01",
  "deploymentId": "dc4518de-d1bf-4fce-b351-e43d7c152999",
  "backendClass": "azure-container-apps-tempo",
  "backendVersion": "3.0.2",
  "protocols": {
    "otlpHttp": {
      "enabled": true,
      "port": 4318,
      "path": "/v1/traces"
    },
    "otlpGrpc": {
      "enabled": true,
      "port": 4317
    }
  },
  "storage": {
    "backend": "azure-blob",
    "authentication": "managed-identity",
    "publicNetworkAccess": false,
    "privateEndpointRequired": true,
    "sharedKeyAccess": false
  },
  "retention": {
    "mechanism": "tempo-per-tenant-compaction",
    "multitenancyRequired": true,
    "tenantHeader": "X-Scope-OrgID",
    "normal": {
      "tenant": "normal",
      "retentionHours": 720,
      "retentionDays": 30
    },
    "incident": {
      "tenant": "incident",
      "retentionHours": 2160,
      "retentionDays": 90
    },
    "incidentLongerThanNormal": true,
    "failClosedRetentionClass": true
  },
  "publicIngress": false,
  "acceptance": {
    "readyEndpoint": "/ready",
    "otlpHttpMustAcceptTrace": true,
    "traceReadBackRequired": true,
    "normalRetentionConfigReadBackRequired": true,
    "incidentRetentionConfigReadBackRequired": true,
    "normalAndIncidentTenantReadBackRequired": true,
    "marker": "TRUYN_TRACE_RETENTION_PASS normal_days=30 incident_days=90 normal_readback=1 incident_readback=1"
  },
  "status": "trace_retention_30d_incident_90d_live_proof_required"
}
