{
  "schema": "truyn.production-trace-export/v1",
  "exportId": "prod-trace-export-01",
  "deploymentId": "dc4518de-d1bf-4fce-b351-e43d7c152999",
  "environmentClass": "production",
  "runtimeRole": "provider",
  "runtimeImageBinding": "exact-main-source-sha",
  "environmentVariable": "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
  "protocol": "otlp/http-protobuf",
  "traceBackendRef": "operations/production-trace-backend.json",
  "endpointScope": "private-loopback-sidecar",
  "endpointPath": "/v1/traces",
  "publicEndpoint": false,
  "sampling": "always_on_for_acceptance_canary",
  "acceptance": {
    "spanName": "truyn.provider.execute",
    "exactTraceReadBackRequired": true,
    "sourceShaBindingRequired": true,
    "marker": "TRUYN_TRACE_EXPORT_PASS span=truyn.provider.execute runtime=production source=exact-main"
  },
  "status": "live_proof_required",
  "invariant": "Sprint 10 is accepted only when an exact-main production runtime image receives OTEL_EXPORTER_OTLP_TRACES_ENDPOINT, emits truyn.provider.execute through the production OpenTelemetry SDK, and Tempo returns that exact trace by its runtime-produced trace id."
}
