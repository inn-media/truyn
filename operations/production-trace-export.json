{
  "schema": "truyn.production-trace-export/v1",
  "exportId": "prod-trace-export-01",
  "deploymentId": "dc4518de-d1bf-4fce-b351-e43d7c152999",
  "environmentClass": "production",
  "runtimeRole": "provider",
  "runtimeImageBinding": "exact-main-source-sha",
  "environmentVariable": "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
  "retentionClassEnvironmentVariable": "TRUYN_TRACE_RETENTION_CLASS",
  "defaultRetentionClass": "normal",
  "allowedRetentionClasses": ["normal", "incident"],
  "tenantHeader": "X-Scope-OrgID",
  "protocol": "otlp/http-protobuf",
  "traceBackendRef": "operations/production-trace-backend.json",
  "endpointScope": "private-loopback-sidecar",
  "endpointPath": "/v1/traces",
  "publicEndpoint": false,
  "sampling": "always_on_for_acceptance_canary",
  "acceptance": {
    "spanName": "truyn.provider.execute",
    "retentionClass": "normal",
    "exactTraceReadBackRequired": true,
    "sourceShaBindingRequired": true,
    "marker": "TRUYN_TRACE_EXPORT_PASS span=truyn.provider.execute runtime=production source=exact-main retention_class=normal"
  },
  "status": "retention_class_live_proof_required",
  "invariant": "Production trace export is fail-closed to the normal or incident retention class. The exact-main acceptance runtime uses normal, and incident-class exporters select the longer-retention Tempo tenant with X-Scope-OrgID."
}
