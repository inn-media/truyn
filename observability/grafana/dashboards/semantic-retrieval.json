{"title":"TRUYN / Semantic Retrieval","uid":"truyn-semantic-retrieval","schemaVersion":39,"tags":["truyn","production","observability"],"time":{"from":"now-6h","to":"now"},"refresh":"30s","panels":[{"id":1,"type":"timeseries","title":"Semantic operation rate","targets":[{"refId":"A","expr":"sum by (operation,outcome) (rate(truyn_semantic_operations_total[5m]))"}]},{"id":2,"type":"timeseries","title":"Semantic failure ratio","targets":[{"refId":"A","expr":"sum(rate(truyn_semantic_operations_total{outcome=\"failure\"}[5m])) / clamp_min(sum(rate(truyn_semantic_operations_total{outcome=~\"success|failure\"}[5m])), 1)"}]},{"id":3,"type":"timeseries","title":"Semantic p95 latency","targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by (le,operation) (rate(truyn_semantic_operation_duration_seconds_bucket[5m])))"}]},{"id":4,"type":"timeseries","title":"Stored contexts","targets":[{"refId":"A","expr":"truyn_relay_contexts"}]}]}
