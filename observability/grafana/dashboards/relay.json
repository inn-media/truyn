{"title":"TRUYN / Relay","uid":"truyn-relay","schemaVersion":39,"tags":["truyn","production","observability"],"time":{"from":"now-6h","to":"now"},"refresh":"30s","panels":[{"id":1,"type":"timeseries","title":"HTTP request rate","targets":[{"refId":"A","expr":"sum by (outcome) (rate(truyn_http_requests_total{surface=\"relay\"}[5m]))"}]},{"id":2,"type":"timeseries","title":"HTTP error ratio","targets":[{"refId":"A","expr":"sum(rate(truyn_http_requests_total{surface=\"relay\",outcome=\"failure\"}[5m])) / clamp_min(sum(rate(truyn_http_requests_total{surface=\"relay\",outcome=~\"success|failure\"}[5m])), 1)"}]},{"id":3,"type":"timeseries","title":"HTTP p95 latency","targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by (le) (rate(truyn_http_request_duration_seconds_bucket{surface=\"relay\"}[5m])))"}]},{"id":4,"type":"timeseries","title":"Dispatch outcomes","targets":[{"refId":"A","expr":"sum by (outcome) (rate(truyn_dispatch_attempts_total[5m]))"}]},{"id":5,"type":"timeseries","title":"RESULT delivery outcomes","targets":[{"refId":"A","expr":"sum by (outcome) (rate(truyn_result_delivery_total[5m]))"}]},{"id":6,"type":"timeseries","title":"Pending requests","targets":[{"refId":"A","expr":"truyn_relay_pending_requests"}]},{"id":7,"type":"timeseries","title":"Provider sockets","targets":[{"refId":"A","expr":"truyn_relay_provider_sockets"}]},{"id":8,"type":"timeseries","title":"Active chains","targets":[{"refId":"A","expr":"truyn_relay_active_chains"}]}]}
