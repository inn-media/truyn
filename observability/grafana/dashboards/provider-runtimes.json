{"title":"TRUYN / Provider Runtimes","uid":"truyn-provider-runtimes","schemaVersion":39,"tags":["truyn","production","observability"],"time":{"from":"now-6h","to":"now"},"refresh":"30s","panels":[{"id":1,"type":"timeseries","title":"Execution rate","targets":[{"refId":"A","expr":"sum by (adapter,outcome) (rate(truyn_provider_executions_total[5m]))"}]},{"id":2,"type":"timeseries","title":"Execution failure ratio","targets":[{"refId":"A","expr":"sum(rate(truyn_provider_executions_total{outcome=\"failure\"}[5m])) / clamp_min(sum(rate(truyn_provider_executions_total[5m])), 1)"}]},{"id":3,"type":"timeseries","title":"Execution p95 latency","targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by (le,adapter) (rate(truyn_provider_execution_duration_seconds_bucket[5m])))"}]},{"id":4,"type":"timeseries","title":"Runtime readiness","targets":[{"refId":"A","expr":"truyn_runtime_ready{role=\"provider\"}"}]},{"id":5,"type":"timeseries","title":"Provider infrastructure errors","targets":[{"refId":"A","expr":"sum by (error_class) (rate(truyn_infrastructure_errors_total{component=~\"provider.*\"}[5m]))"}]}]}
