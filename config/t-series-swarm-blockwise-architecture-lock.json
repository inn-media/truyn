{
  "schema": "truyn.t-series.swarm-blockwise-architecture-lock.v1",
  "purpose": "T-Series commercial-proof qualification and measured benchmark admission discipline; not a TRUYN network runtime",
  "isolation": {
    "series": "T",
    "privateExecutionNamespace": ".github/t-series/",
    "publicMayDependOnPrivate": false,
    "privateMayDependOnPublic": true,
    "seriesCanRunConcurrentlyWithOtherSeries": true,
    "foreignSeriesMustNeverBeWaitDependency": true,
    "onlyRealSharedMutableR2ResourceMayCauseWaiting": true,
    "waitingState": "WAITING_SHARED_RESOURCE",
    "globalBenchmarkConcurrencyLockForbidden": true
  },
  "sourceBinding": {
    "exactPublicSourceShaRequired": true,
    "exactPrivateExecutionShaRequired": true,
    "expensiveQualificationBindsToFrozenCandidate": true,
    "mainMovementAloneInvalidatesCandidate": false,
    "mainMovementTriggersAdmissionAnalysis": true,
    "baseToCurrentMainDiffRequired": true,
    "integrationCandidateFingerprintRequired": true,
    "candidateEvidenceSurvivesUnrelatedMainMovement": true,
    "targetedBlockRequalificationOnSensitiveMainMovement": true,
    "automaticFullLiveRerunOnMainMovement": false,
    "historicalMeasuredRunsAreImmutable": true
  },
  "qualificationSwarm": {
    "mode": "fail-collect",
    "failFast": false,
    "blocks": ["TS0", "TS1", "TS2", "TS3", "TS4", "TS5", "TS6"],
    "parallelByDefault": true,
    "allRequiredGreenBeforeMeasuredLaneAdmission": true,
    "paidProviderCallsAllowed": false,
    "evidenceBindsToFrozenCandidate": true,
    "rerunOnlyAffectedBlocksAfterSensitiveChange": true
  },
  "measuredBenchmarkSwarm": {
    "parallelByDefault": true,
    "crossLaneNeedsForbidden": true,
    "crossLaneCancellationForbidden": true,
    "crossLaneMutableStateReuseForbidden": true,
    "lanes": [
      {
        "id": "BREAK_EVEN",
        "benchmarkId": "T/BREAK-EVEN",
        "roadmapStage": "TS7",
        "independent": true,
        "runManifestRequired": true,
        "paidExecution": true
      },
      {
        "id": "HEAD_TO_HEAD",
        "benchmarkId": "T/HEAD-TO-HEAD",
        "roadmapStage": "TS8",
        "independent": true,
        "runManifestRequired": true,
        "paidExecution": true
      },
      {
        "id": "PREDICT",
        "benchmarkId": "T/PREDICT",
        "roadmapStage": "TS9",
        "independent": true,
        "runManifestRequired": true,
        "paidExecution": true
      }
    ]
  },
  "sharedPaidBoundary": {
    "requiredBeforeEveryMeasuredLane": [
      "QUALIFICATION_SWARM_GREEN_FOR_EXACT_FROZEN_CANDIDATE",
      "BLOCKWISE_ADMISSION_GREEN_FOR_CURRENT_INTEGRATION_CANDIDATE",
      "R1_ATTRIBUTION_AND_INTERFERENCE_GUARD_GREEN",
      "R2_COLLISION_AND_EXCLUSIVE_LEASE_GUARD_GREEN",
      "RUN_BUDGET_GUARD_GREEN",
      "DUPLICATE_HISTORY_GUARD_GREEN",
      "EXACT_CANDIDATE_AND_MANIFEST_IDENTITY_GREEN"
    ],
    "gateIsEvaluatedPerLane": true,
    "oneLaneNeverWaitsForAnotherLaneResult": true,
    "simultaneousPaidLanesAllowedWhenResourceScopesAreDisjointOrR1Safe": true,
    "simultaneousPaidLanesOnSameR2FaultDomainForbidden": true,
    "providerCallsBeforeGate": 0,
    "admissionCanNeverInferOrAutoDispatchPaidCalls": true
  },
  "resourceIsolation": {
    "R0": "immutable/read-only shared dependencies may be used concurrently",
    "R1": "shared services may be used concurrently only with distinct attribution and active interference detection",
    "R2": "exclusive mutable/fault targets require a scoped lease; only runs sharing the exact R2 scope may serialize",
    "requiredNamespace": "T/<benchmark-id>/<run-id>",
    "perLaneRunState": true,
    "perLaneTelemetry": true,
    "perLaneArtifacts": true,
    "perLaneCaches": true,
    "perLaneBudgets": true,
    "perLaneCleanupOwnership": true
  },
  "concurrency": {
    "qualificationGroupPattern": "T-QUALIFICATION-<candidate-sha>-<block-id>",
    "admissionGroupPattern": "T-ADMISSION-<candidate-sha>-<resource-scope>",
    "measuredLaneGroupPattern": "T-<benchmark-id>-<resource-scope>",
    "cancelInProgressAcrossDifferentLanes": false,
    "cancelInProgressAcrossDifferentSeries": false,
    "repositoryWideOrSeriesWideGlobalLockAllowed": false
  },
  "acceptance": {
    "foundationBlocks": 7,
    "qualificationRequiresAllApplicableBlocksGreen": true,
    "measuredLaneAdmissionRequiresFreshCommonPaidBoundary": true,
    "measuredLaneResultsDoNotAuthorizeOtherLanes": true,
    "failureInOneMeasuredLaneDoesNotInvalidateOrBlockOtherIndependentLanes": true,
    "unknownProtectedTChangeFailsClosed": true,
    "acceptanceWeakeningForbidden": true
  },
  "forbidden": [
    "serial BREAK-EVEN -> HEAD-TO-HEAD -> PREDICT dependency",
    "cross-lane workflow needs between independent measured lanes",
    "waiting for an unrelated T lane or foreign benchmark series",
    "global benchmark concurrency locks used only for orchestration convenience",
    "reuse of mutable run state, cache namespace, artifact prefix, budget counter or cleanup scope across T lanes",
    "paid provider calls before fresh lane-specific admission guards",
    "automatic paid inference caused only by main movement",
    "discarding frozen-candidate evidence because unrelated main changed",
    "rerunning all TS0-TS6 when only a classified subset changed",
    "using one lane PASS as evidence for another lane",
    "weakening thresholds to manufacture GREEN"
  ]
}
