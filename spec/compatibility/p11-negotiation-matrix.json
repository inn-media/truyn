        ],
        "remoteProtocols": [
          "TRUYN/1"
        ],
        "localSemantics": [
          "core-envelope"
        ],
        "remoteSemantics": [
          "core-envelope"
        ],
        "requiredSemantics": [
          "core-envelope"
        ]
      },
      "expected": {
        "ok": true,
        "protocol": "TRUYN/1",
        "semantics": [
          "core-envelope"
        ]
      }
    },
