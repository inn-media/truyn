{
  "schemaVersion": 1,
  "matrixId": "truyn-p11-required-semantic-negotiation/rc1",
  "status": "frozen-release-candidate-contract",
  "stableProtocolDeclared": false,
  "scope": "Deterministic protocol-generation/semantic negotiation decision outcomes; not a TRUYN/2 runtime or stable-v1 release claim",
  "normative": "spec/protocol/v1/core.md#compatibility-and-negotiation",
  "implementation": "core/protocol/negotiation.js",
  "cases": [
    {
      "id": "negotiation.exact-generation-required-present",
      "disposition": "compatible",
      "input": {
        "localProtocols": [
          "TRUYN/1"
        ],
        "remoteProtocols": [
          "TRUYN/1"
        ],
        "localSemantics": [
          "core-envelope",
          "revoke-need"
        ],
        "remoteSemantics": [
          "core-envelope",
          "revoke-need"
        ],
        "requiredSemantics": [
          "core-envelope"
        ]
      },
      "expected": {
        "ok": true,
        "protocol": "TRUYN/1",
        "semantics": [
          "core-envelope",
          "revoke-need"
        ]
      }
    },
    {
      "id": "negotiation.highest-shared-generation-synthetic",
      "disposition": "compatible",
      "input": {
        "localProtocols": [
          "TRUYN/1",
          "TRUYN/2"
        ],
        "remoteProtocols": [
          "TRUYN/2",
          "TRUYN/1"
        ],
        "localSemantics": [
          "core-envelope",
          "revoke-need"
        ],
        "remoteSemantics": [
          "revoke-need",
          "core-envelope"
        ],
        "requiredSemantics": [
          "core-envelope"
        ]
      },
      "expected": {
        "ok": true,
        "protocol": "TRUYN/2",
        "semantics": [
          "core-envelope",
          "revoke-need"
        ]
      }
    },
    {
