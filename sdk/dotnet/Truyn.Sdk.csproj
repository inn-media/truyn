<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Truyn.Sdk</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>TRUYN maintainers</Authors>
    <Description>First-party C#/.NET SDK for the TRUYN Intelligence Network.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/inn-media/truyn</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://truyn.org</PackageProjectUrl>
    <PackageTags>truyn;ai;agents;intelligence-network</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="conformance/**/*.cs" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <None Include="LICENSE" Pack="true" PackagePath="" />
    <None Include="NOTICE" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
