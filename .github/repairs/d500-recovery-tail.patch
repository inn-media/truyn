diff --git a/tests/class-d-remote-errtrace.test.js b/tests/class-d-remote-errtrace.test.js
new file mode 100644
--- /dev/null
+++ b/tests/class-d-remote-errtrace.test.js
@@ -0,0 +1,25 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, writeFile, chmod, readFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { spawnSync } from 'node:child_process';
+
+test('Class-D remote() retries a transient run-command failure under an inherited ERR trap', async () => {
+  const dir = await mkdtemp(join(tmpdir(), 'truyn-remote-errtrace-'));
+  try {
+    const provision = await readFile('benchmarks/scale/class-d-azure-1000-provision.sh', 'utf8');
+    const remoteFn = provision.match(/^remote\(\) \{[\s\S]*?^\}/m)?.[0];
+    assert.ok(remoteFn, 'remote() must exist in the shared provisioner');
+    await writeFile(join(dir, 'az'), '#!/usr/bin/env bash\nif [[ ! -f "$STATE/failed" ]]; then touch "$STATE/failed"; echo "ERROR: (Conflict) Run command extension execution is in progress." >&2; exit 1; fi\necho OK_MARKER=1\n');
+    await chmod(join(dir, 'az'), 0o755);
+    const script = `${remoteFn}\nsleep() { :; }\nRG=rg\n(\n  trap 'exit 97' ERR\n  set -Eeuo pipefail\n  (remote vm-h0 'true' >"${dir}/out") &\n  wait $! || { echo BACKGROUND_REMOTE_KILLED; exit 1; }\n  grep -q OK_MARKER=1 "${dir}/out"\n  echo STAGE_OK\n)\n`;
+    const run = spawnSync('bash', ['-c', script], { encoding: 'utf8', env: { ...process.env, PATH: `${dir}:${process.env.PATH}`, STATE: dir } });
+    assert.match(run.stdout, /STAGE_OK/, `stdout=${run.stdout} stderr=${run.stderr}`);
+    assert.doesNotMatch(run.stdout, /BACKGROUND_REMOTE_KILLED/);
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});
diff --git a/tests/d500-recovery-tail.test.js b/tests/d500-recovery-tail.test.js
new file mode 100644
--- /dev/null
+++ b/tests/d500-recovery-tail.test.js
@@ -0,0 +1,56 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { DirectFirstP2P } from '../network/transport/p2p.js';
+
+test('cached direct session is control-probed before a second application dispatch', async () => {
+  let connects = 0;
+  const disconnects = [];
+  const applicationClients = [];
+  const record = {
+    nodeId: 'truyn:node:d500-recovery-target',
+    endpoints: ['quic://127.0.0.1:4100'],
+    instanceId: 'instance-before-observed-refresh',
+    sequence: 7
+  };
+  const discovery = { get: (nodeId) => nodeId === record.nodeId ? record : null };
+  const quicTransport = {
+    async connect(endpoint) { return { serial: ++connects, endpoint }; },
+    async disconnect(client) { disconnects.push(client.serial); },
+    async requestControl(client, method) {
+      assert.equal(method, 'dht.ping');
+      if (client.serial === 1) return new Promise(() => {});
+      return { pong: true };
+    },
+    async sendEnvelope(client) {
+      applicationClients.push(client.serial);
+      return { echoed: true };
+    }
+  };
+  const router = new DirectFirstP2P({
+    quicTransport,
+    discovery,
+    routeAttemptTimeoutMs: 500,
+    directConnectTimeoutMs: 100,
+    directConnectAttempts: 1,
+    directConnectionReuseIdleMs: 20_000,
+    directReuseProbeTimeoutMs: 20
+  });
+
+  await router.send(record.nodeId, { id: 'first' }, { allowRelayFallback: false });
+  await router.send(record.nodeId, { id: 'second' }, { allowRelayFallback: false });
+
+  assert.equal(connects, 2, 'stale cached client must be replaced before second application dispatch');
+  assert.deepEqual(applicationClients, [1, 2], 'application envelope must never be retried on the stale client');
+  assert.ok(disconnects.includes(1), 'failed control probe must retire the stale cached client');
+});
+
+test('restart peer-record announcement fanout has a bounded concurrency floor above lookup alpha', async () => {
+  const source = await readFile(new URL('../network/runtime.js', import.meta.url), 'utf8');
+  assert.match(source, /DEFAULT_PEER_RECORD_ANNOUNCE_CONCURRENCY\s*=\s*8/);
+  assert.match(source, /Math\.min\(candidates\.length, Math\.max\(this\.alpha, DEFAULT_PEER_RECORD_ANNOUNCE_CONCURRENCY\)\)/);
+  assert.match(source, /peerRecordRecoveryRetryDelaysMs\s*=\s*\[500, 1_500, 5_000, 10_000, 20_000\]/,
+    'unchanged retry schedule remains bounded by the Class-D recovery contract');
+});
