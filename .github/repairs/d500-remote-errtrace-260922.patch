--- a/benchmarks/scale/class-d-azure-1000-provision.sh
+++ b/benchmarks/scale/class-d-azure-1000-provision.sh
@@ -58,10 +58,15 @@ remote() {
   remote_script="${remote_script//truyn/truyn}"
   remote_script="${remote_script//truyn/truyn}"
   for attempt in 1 2 3 4 5; do
-    set +e
-    output=$(az vm run-command invoke -g "$RG" -n "$vm" --command-id RunShellScript --scripts "$remote_script" --query 'value[0].message' -o tsv --only-show-errors 2>&1)
-    rc=$?
-    set -e
+    # The az call must be an `if` condition, not `set +e; x=$(az …); rc=$?`: `set +e`
+    # only disables errexit. Stage runners install an ERR trap with errtrace (set -E),
+    # which is inherited here and would `exit` on the first transient run-command error
+    # (409 Conflict, throttling, agent busy) before this retry loop ever retries.
+    if output=$(az vm run-command invoke -g "$RG" -n "$vm" --command-id RunShellScript --scripts "$remote_script" --query 'value[0].message' -o tsv --only-show-errors 2>&1); then
+      rc=0
+    else
+      rc=$?
+    fi
     printf '%s\n' "$output" >&2
     if [[ $rc -eq 0 ]]; then
       printf '%s\n' "$output"
