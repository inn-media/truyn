diff --git a/tests/class-d-remote-errtrace.test.js b/tests/class-d-remote-errtrace.test.js
new file mode 100644
index 0000000..5db9e0a
--- /dev/null
+++ b/tests/class-d-remote-errtrace.test.js
@@ -0,0 +1,25 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, writeFile, chmod, readFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { spawnSync } from 'node:child_process';
+
+// Stage runners install `trap … exit ERR` with `set -E`; errtrace reaches remote() inside
+// background subshells. One transient `az vm run-command` failure must be retried, not fatal.
+test('Class-D remote() retries a transient run-command failure under an inherited ERR trap', async () => {
+  const dir = await mkdtemp(join(tmpdir(), 'truyn-remote-errtrace-'));
+  try {
+    const provision = await readFile('benchmarks/scale/class-d-azure-1000-provision.sh', 'utf8');
+    const remoteFn = provision.match(/^remote\(\) \{[\s\S]*?^\}/m)?.[0];
+    assert.ok(remoteFn, 'remote() must exist in the shared provisioner');
+    await writeFile(join(dir, 'az'), '#!/usr/bin/env bash\nif [[ ! -f "$STATE/failed" ]]; then touch "$STATE/failed"; echo "ERROR: (Conflict) Run command extension execution is in progress." >&2; exit 1; fi\necho OK_MARKER=1\n');
+    await chmod(join(dir, 'az'), 0o755);
+    const script = `${remoteFn}\nsleep() { :; }\nRG=rg\n(\n  trap 'exit 97' ERR\n  set -Eeuo pipefail\n  (remote vm-h0 'true' >"${dir}/out") &\n  wait $! || { echo BACKGROUND_REMOTE_KILLED; exit 1; }\n  grep -q OK_MARKER=1 "${dir}/out"\n  echo STAGE_OK\n)\n`;
+    const run = spawnSync('bash', ['-c', script], { encoding: 'utf8', env: { ...process.env, PATH: `${dir}:${process.env.PATH}`, STATE: dir } });
+    assert.match(run.stdout, /STAGE_OK/, `stdout=${run.stdout} stderr=${run.stderr}`);
+    assert.doesNotMatch(run.stdout, /BACKGROUND_REMOTE_KILLED/);
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});
